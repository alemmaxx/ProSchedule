rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- ProSchedule (sync antara telefon) ----------
    // ID 20 aksara rawak = "kunci". Tiada senarai/padam, jadi orang lain tak boleh
    // menjumpai ID. Hanya medan 'data' (teks) dan 'updated' dibenarkan, maksimum ~500 KB.
    match /psync/{code} {
      allow get: if code.size() == 20;
      allow create, update: if code.size() == 20
        && request.resource.data.keys().hasOnly(['data', 'updated'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 500000;
      allow list, delete: if false;
    }

    // ---------- ProIklan ----------
    // Ganti HCwfvnxYQoe0LmJpuyDsUZw32dy2 dengan User UID akaun admin (Authentication > Users).
    function isAdmin() {
      return request.auth != null && request.auth.uid in ['HCwfvnxYQoe0LmJpuyDsUZw32dy2'];
    }

    match /iklan/{id} {
      allow read: if resource.data.status == 'live' || isAdmin();
      allow write: if isAdmin();
    }
    match /peraduan/{id} {
      allow read: if resource.data.status == 'live' || isAdmin();
      allow write: if isAdmin();
    }

    // ---------- Peraturan sedia ada (disalin tanpa ubah) ----------
    match /users/{u} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == u;
    }

    match /groups/{g} {
      allow get: if request.auth != null;
      allow list: if request.auth != null
        && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && (
        request.resource.data.members == [request.auth.uid]
        || (request.resource.data.get('type', 'group') == 'direct'
            && request.resource.data.members.size() == 2
            && request.auth.uid in request.resource.data.members));
      allow update: if request.auth != null
        && resource.data.get('type', 'group') != 'direct'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.auth.uid in request.resource.data.members;
      allow delete: if false;
    }
  }
}
